# Dependencies
node_modules/
*/node_modules/
**/node_modules/

# Environment variables (Sensitive secrets)
.env
**/.env
.env.local
.env.*.local

# Sensitive credentials & keys
**/*.pem
**/*.key
**/media/*.json
**/public/media/*.json

# Temporary database dumps
extract_to _server/database/*.sql

# WhatsApp session files & temp data
**/sessions/
sessions/
tmp/
*.log

# OS generated files
.DS_Store
Thumbs.db
